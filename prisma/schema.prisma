generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum HouseholdMembershipRole {
  ADMIN
  MEMBER
}

enum HouseholdMembershipStatus {
  ACTIVE
  INACTIVE
}

enum HouseholdInvitationRole {
  ADMIN
  MEMBER
}

enum HouseholdInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum BiologicalSex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  HIGH
  VERY_HIGH
}

enum PrimaryGoal {
  FAT_LOSS
  MAINTENANCE
  MUSCLE_GAIN
}

enum DietaryRestrictionType {
  ALLERGY
  INTOLERANCE
  PREFERENCE
}

enum FoodType {
  GENERIC
  COMMERCIAL
  CUSTOM
  PREPARED
}

enum PreparationState {
  RAW
  COOKED
  READY_TO_EAT
  NOT_APPLICABLE
}

enum ReferenceUnit {
  GRAM
  MILLILITER
  UNIT
}

enum ConfidenceLevel {
  VERIFIED
  HIGH
  MEDIUM
  LOW
  USER_PROVIDED
}

enum NutritionGoalSuggestionStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
  EXTRA
}

enum MealStatus {
  CONFIRMED
  CANCELLED
}

enum MealSource {
  MANUAL
  DUPLICATED
  PREPARED_BATCH
  PREPARED_INVENTORY
}

enum MealMeasurementMethod {
  WEIGHED
  SERVING
  UNIT
  APPROXIMATED
}

enum BodyWeightUnit {
  KG
  LB
}

enum BodyMeasurementUnit {
  CM
  IN
}

enum BodyMeasurementSource {
  MANUAL
  IMPORTED
  DEVICE
}

enum BodyMeasurementType {
  WAIST
  HIPS
  CHEST
  ARM_LEFT
  ARM_RIGHT
  THIGH_LEFT
  THIGH_RIGHT
  NECK
  CALF_LEFT
  CALF_RIGHT
  CUSTOM
}

enum DigestiveSymptomType {
  GAS
  BLOATING
  ABDOMINAL_PAIN
  HEARTBURN
  NAUSEA
  DIARRHEA
  CONSTIPATION
  OTHER
}

enum DigestiveSymptomStatus {
  ACTIVE
  RESOLVED
  CORRECTED
  CANCELLED
}

enum DigestiveSymptomFoodLinkSource {
  MEAL_SELECTED
  FOOD_FROM_MEAL
  MANUAL_HYPOTHESIS
}

enum RecipeStatus {
  ACTIVE
  ARCHIVED
}

enum RecipeIngredientUnit {
  GRAM
  MILLILITER
  UNIT
  SERVING
}

enum PreparedBatchStatus {
  DRAFT
  INGREDIENTS_CONFIRMED
  FINALIZED
  CANCELLED
}

enum ServedPortionStatus {
  SERVED
  CONSUMED
  CANCELLED
}

enum PortionRemainderDisposition {
  SAVED
  DISCARDED
  SHARED
  CONSUMED_LATER
}

enum PreparedFoodLeftoverStatus {
  AVAILABLE
  CONSUMED
  DISCARDED
  EXPIRED
}

enum InventoryUnit {
  GRAM
  MILLILITER
  UNIT
}

enum InventoryItemType {
  FOOD
  PREPARED_FOOD
  CUSTOM
}

enum InventoryItemStatus {
  ACTIVE
  DEPLETED
  ARCHIVED
}

enum InventoryMovementType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  WASTE
  EXPIRATION
  PREPARATION_CONSUMPTION
  REMAINDER_RETURN
  MANUAL_ENTRY
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ShoppingListSource {
  MANUAL
  BELOW_MINIMUM
  DEPLETED
  MEAL_PLAN
}

enum ShoppingListItemStatus {
  PENDING
  PURCHASED
  REMOVED
}

enum WeeklyPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PlannedMealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum PlannedMealStatus {
  PLANNED
  PREPARED
  SERVED
  CONSUMED
  SKIPPED
  REPLACED
  CANCELLED
}

enum PlannedMealSource {
  RECIPE
  PREVIOUS_MEAL
  FREE_MEAL
  RESTAURANT
  DELIVERY
  UNPLANNED
  EMPTY
}

// Technical model for validating the local Prisma migration and seed flow.
model TechnicalSeed {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("_technical_seed")
}

model User {
  id                      String                @id @default(uuid()) @db.Uuid
  authProviderId          String                @unique @map("auth_provider_id") @db.VarChar(255)
  email                   String                @unique @db.VarChar(320)
  displayName             String?               @map("display_name") @db.VarChar(150)
  avatarUrl               String?               @map("avatar_url") @db.VarChar(2048)
  timezone                String                @default("America/Argentina/Buenos_Aires") @db.VarChar(64)
  locale                  String                @default("es-AR") @db.VarChar(10)
  lastLoginAt             DateTime?             @map("last_login_at") @db.Timestamptz(6)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdHouseholds       Household[]           @relation("HouseholdCreatedBy")
  memberships             HouseholdMembership[] @relation("UserMemberships")
  invitationsSent         HouseholdInvitation[] @relation("HouseholdInvitationInviter")
  invitationsAccepted     HouseholdInvitation[] @relation("HouseholdInvitationAccepter")
  adultProfiles           AdultProfile[]
  foodsCreated            Food[]                @relation("FoodCreatedBy")
  nutritionGoalsConfirmed NutritionGoal[]       @relation("NutritionGoalConfirmedBy")
  plannedMealParticipantsConfirmed PlannedMealParticipant[] @relation("PlannedMealParticipantConfirmedBy")
  mealsCreated            Meal[]                @relation("MealCreatedBy")
  recipesCreated          Recipe[]              @relation("RecipeCreatedBy")
  preparedBatchesCreated  PreparedBatch[]       @relation("PreparedBatchCreatedBy")
  servedPortionsCreated   ServedPortion[]       @relation("ServedPortionCreatedBy")
  inventoryMovements      InventoryMovement[]   @relation("InventoryMovementActor")
  inventorySyncOperations InventorySyncOperation[] @relation("InventorySyncOperationActor")
  preparationInventoryConsumptions PreparationInventoryConsumption[]
  purchasesRegistered     Purchase[]            @relation("PurchaseRegisteredBy")
  shoppingItemsCreated    ShoppingListItem[]    @relation("ShoppingListItemActor")
  shoppingItemsPurchased  ShoppingListItem[]    @relation("ShoppingListItemPurchaser")
  shoppingItemsRemoved    ShoppingListItem[]    @relation("ShoppingListItemRemover")
  weeklyPlansCreated      WeeklyPlan[]          @relation("WeeklyPlanCreatedBy")

  @@map("users")
}

model Household {
  id              String                @id @default(uuid()) @db.Uuid
  name            String                @db.VarChar(150)
  timezone        String                @default("America/Argentina/Buenos_Aires") @db.VarChar(64)
  currency        String                @default("ARS") @db.VarChar(3)
  weeklyBudget    Decimal?              @map("weekly_budget") @db.Decimal(12, 2)
  createdById     String                @map("created_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdBy       User                  @relation("HouseholdCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  memberships     HouseholdMembership[]
  invitations     HouseholdInvitation[]
  adultProfiles   AdultProfile[]
  foods           Food[]
  meals           Meal[]
  recipes         Recipe[]
  preparedBatches PreparedBatch[]
  preparedFoodLeftovers PreparedFoodLeftover[]
  inventoryItems        InventoryItem[]
  inventorySyncOperations InventorySyncOperation[]
  preparationInventoryConsumptions PreparationInventoryConsumption[]
  purchases             Purchase[]
  shoppingLists         ShoppingList[]
  weeklyPlans           WeeklyPlan[]

  @@index([createdById])
  @@index([deletedAt])
  @@map("households")
}

model BodyWeightEntry {
  id              String              @id @default(uuid()) @db.Uuid
  adultProfileId  String              @map("adult_profile_id") @db.Uuid
  value           Decimal             @db.Decimal(18, 6)
  unit            BodyWeightUnit
  recordedAt      DateTime            @map("recorded_at") @db.Timestamptz(6)
  source          BodyMeasurementSource
  correctedFromId String?             @map("corrected_from_id") @db.Uuid
  adultProfile    AdultProfile        @relation(fields: [adultProfileId], references: [id], onDelete: Cascade)
  correctedFrom   BodyWeightEntry?    @relation("BodyWeightCorrections", fields: [correctedFromId], references: [id], onDelete: Restrict)
  corrections     BodyWeightEntry[]   @relation("BodyWeightCorrections")

  @@index([adultProfileId, recordedAt])
  @@index([adultProfileId, unit])
  @@index([correctedFromId])
  @@map("body_weight_entries")
}

model BodyMeasurementEntry {
  id                    String                @id @default(uuid()) @db.Uuid
  adultProfileId        String                @map("adult_profile_id") @db.Uuid
  type                  BodyMeasurementType
  customMeasurementName String?               @map("custom_measurement_name") @db.VarChar(100)
  value                 Decimal               @db.Decimal(18, 6)
  unit                  BodyMeasurementUnit
  recordedAt            DateTime              @map("recorded_at") @db.Timestamptz(6)
  source                BodyMeasurementSource
  correctedFromId       String?               @map("corrected_from_id") @db.Uuid
  adultProfile          AdultProfile          @relation(fields: [adultProfileId], references: [id], onDelete: Cascade)
  correctedFrom         BodyMeasurementEntry? @relation("BodyMeasurementCorrections", fields: [correctedFromId], references: [id], onDelete: Restrict)
  corrections           BodyMeasurementEntry[] @relation("BodyMeasurementCorrections")

  @@index([adultProfileId, recordedAt])
  @@index([adultProfileId, type, recordedAt])
  @@index([correctedFromId])
  @@map("body_measurement_entries")
}

model MeasurementConfiguration {
  id                 String                       @id @default(uuid()) @db.Uuid
  adultProfileId     String                       @unique @map("adult_profile_id") @db.Uuid
  enabledTypes       BodyMeasurementType[]        @map("enabled_types")
  units              Json
  adultProfile       AdultProfile                 @relation(fields: [adultProfileId], references: [id], onDelete: Cascade)
  customMeasurements CustomMeasurementDefinition[]

  @@map("measurement_configurations")
}

model CustomMeasurementDefinition {
  id              String                 @id @default(uuid()) @db.Uuid
  configurationId String                 @map("configuration_id") @db.Uuid
  name            String                 @db.VarChar(100)
  normalizedName  String                 @map("normalized_name") @db.VarChar(100)
  unit            BodyMeasurementUnit
  enabled         Boolean                @default(true)
  configuration   MeasurementConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([configurationId, normalizedName])
  @@index([configurationId, enabled])
  @@map("custom_measurement_definitions")
}

model HouseholdMembership {
  id          String                    @id @default(uuid()) @db.Uuid
  householdId String                    @map("household_id") @db.Uuid
  userId      String                    @map("user_id") @db.Uuid
  role        HouseholdMembershipRole
  status      HouseholdMembershipStatus
  joinedAt    DateTime                  @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  household   Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User                      @relation("UserMemberships", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([householdId, userId])
  @@index([householdId, status])
  @@index([userId, status])
  @@map("household_memberships")
}

model HouseholdInvitation {
  id           String                    @id @default(uuid()) @db.Uuid
  householdId  String                    @map("household_id") @db.Uuid
  email        String                    @db.VarChar(320)
  tokenHash    String                    @unique @map("token_hash") @db.VarChar(255)
  role         HouseholdInvitationRole
  status       HouseholdInvitationStatus
  expiresAt    DateTime                  @map("expires_at") @db.Timestamptz(6)
  invitedById  String                    @map("invited_by_id") @db.Uuid
  acceptedById String?                   @map("accepted_by_id") @db.Uuid
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  household    Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy    User                      @relation("HouseholdInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?                     @relation("HouseholdInvitationAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([householdId, status])
  @@index([email])
  @@index([invitedById])
  @@index([acceptedById])
  @@map("household_invitations")
}

model AdultProfile {
  id                       String                    @id @default(uuid()) @db.Uuid
  householdId              String                    @map("household_id") @db.Uuid
  userId                   String                    @map("user_id") @db.Uuid
  name                     String                    @db.VarChar(150)
  birthDate                DateTime                  @map("birth_date") @db.Date
  biologicalSex            BiologicalSex             @map("biological_sex")
  weightKg                 Decimal?                  @map("weight_kg") @db.Decimal(5, 2)
  heightCm                 Decimal                   @map("height_cm") @db.Decimal(5, 2)
  activityLevel            ActivityLevel             @map("activity_level")
  primaryGoal              PrimaryGoal               @map("primary_goal")
  hasKitchenScale          Boolean                   @map("has_kitchen_scale")
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  household                Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  dietaryRestrictions      DietaryRestriction[]
  nutritionGoalSuggestions NutritionGoalSuggestion[]
  nutritionGoals           NutritionGoal[]
  meals                    Meal[]
  servedPortions           ServedPortion[]
  plannedMealParticipants  PlannedMealParticipant[]
  bodyWeightEntries        BodyWeightEntry[]
  bodyMeasurementEntries   BodyMeasurementEntry[]
  measurementConfiguration MeasurementConfiguration?
  digestiveSymptomEntries  DigestiveSymptomEntry[]

  @@index([householdId, isActive])
  @@index([userId, isActive])
  @@map("adult_profiles")
}

model NutritionGoalSuggestion {
  id                         String                        @id @default(uuid()) @db.Uuid
  adultProfileId             String                        @map("adult_profile_id") @db.Uuid
  calculationMethod          String                        @map("calculation_method") @db.VarChar(100)
  calculationInput           Json                          @map("calculation_input")
  bmr                        Decimal                       @db.Decimal(12, 4)
  tdee                       Decimal                       @db.Decimal(12, 4)
  suggestedCalories          Decimal                       @map("suggested_calories") @db.Decimal(12, 4)
  suggestedProteinGrams      Decimal                       @map("suggested_protein_grams") @db.Decimal(12, 4)
  suggestedCarbohydrateGrams Decimal                       @map("suggested_carbohydrate_grams") @db.Decimal(12, 4)
  suggestedFatGrams          Decimal                       @map("suggested_fat_grams") @db.Decimal(12, 4)
  suggestedFiberGrams        Decimal                       @map("suggested_fiber_grams") @db.Decimal(12, 4)
  status                     NutritionGoalSuggestionStatus @default(PENDING)
  createdAt                  DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt                  DateTime                      @map("expires_at") @db.Timestamptz(6)
  adultProfile               AdultProfile                  @relation(fields: [adultProfileId], references: [id], onDelete: Cascade)

  @@index([adultProfileId, status])
  @@index([status, expiresAt])
  @@map("nutrition_goal_suggestions")
}

/// The migration adds a partial unique index for one row with valid_until IS NULL per profile.
model NutritionGoal {
  id                String       @id @default(uuid()) @db.Uuid
  adultProfileId    String       @map("adult_profile_id") @db.Uuid
  validFrom         DateTime     @map("valid_from") @db.Timestamptz(6)
  validUntil        DateTime?    @map("valid_until") @db.Timestamptz(6)
  dailyCalories     Decimal      @map("daily_calories") @db.Decimal(12, 4)
  proteinGrams      Decimal      @map("protein_grams") @db.Decimal(12, 4)
  carbohydrateGrams Decimal      @map("carbohydrate_grams") @db.Decimal(12, 4)
  fatGrams          Decimal      @map("fat_grams") @db.Decimal(12, 4)
  fiberGrams        Decimal      @map("fiber_grams") @db.Decimal(12, 4)
  goalType          String       @map("goal_type") @db.VarChar(50)
  calculationMethod String       @map("calculation_method") @db.VarChar(100)
  calculationInput  Json         @map("calculation_input")
  confirmedById     String       @map("confirmed_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  adultProfile      AdultProfile @relation(fields: [adultProfileId], references: [id], onDelete: Cascade)
  confirmedBy       User         @relation("NutritionGoalConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([adultProfileId, validFrom])
  @@index([confirmedById])
  @@map("nutrition_goals")
}

model DietaryRestriction {
  id             String                 @id @default(uuid()) @db.Uuid
  adultProfileId String                 @map("adult_profile_id") @db.Uuid
  type           DietaryRestrictionType
  name           String                 @db.VarChar(150)
  severity       String?                @db.VarChar(100)
  notes          String?                @db.Text
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  adultProfile   AdultProfile           @relation(fields: [adultProfileId], references: [id], onDelete: Cascade)

  @@index([adultProfileId])
  @@map("dietary_restrictions")
}

model FoodCategory {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique @db.VarChar(50)
  name         String  @db.VarChar(100)
  displayOrder Int     @map("display_order")
  isActive     Boolean @default(true) @map("is_active")
  foods        Food[]

  @@index([isActive, displayOrder])
  @@map("food_categories")
}

model NutrientDefinition {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique @db.VarChar(50)
  name          String         @db.VarChar(100)
  unit          String         @db.VarChar(20)
  group         String         @map("nutrient_group") @db.VarChar(50)
  displayOrder  Int            @map("display_order")
  isRequired    Boolean        @default(false) @map("is_required")
  foodNutrients FoodNutrient[]

  @@index([group, displayOrder])
  @@index([isRequired])
  @@map("nutrient_definitions")
}

model Food {
  id                       String                    @id @default(uuid()) @db.Uuid
  householdId              String?                   @map("household_id") @db.Uuid
  name                     String                    @db.VarChar(150)
  brand                    String?                   @db.VarChar(150)
  description              String?                   @db.Text
  categoryId               String                    @map("category_id") @db.Uuid
  foodType                 FoodType                  @map("food_type")
  preparationState         PreparationState          @map("preparation_state")
  referenceQuantity        Decimal                   @map("reference_quantity") @db.Decimal(12, 4)
  referenceUnit            ReferenceUnit             @map("reference_unit")
  source                   String                    @db.VarChar(100)
  sourceReference          String?                   @map("source_reference") @db.VarChar(255)
  confidenceLevel          ConfidenceLevel           @map("confidence_level")
  isGlobal                 Boolean                   @default(false) @map("is_global")
  isActive                 Boolean                   @default(true) @map("is_active")
  createdById              String?                   @map("created_by_id") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  household                Household?                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category                 FoodCategory              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy                User?                     @relation("FoodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  nutrients                FoodNutrient[]
  servings                 FoodServing[]
  aliases                  FoodAlias[]
  mealItems                MealItem[]
  recipeIngredients        RecipeIngredient[]
  preparedBatchIngredients PreparedBatchIngredient[]
  inventoryItems           InventoryItem[]
  purchaseItems            PurchaseItem[]
  shoppingListItems        ShoppingListItem[]
  digestiveSymptomFoodLinks DigestiveSymptomFoodLink[]

  @@unique([source, sourceReference])
  @@index([householdId, isActive])
  @@index([isGlobal, isActive])
  @@index([categoryId, isActive])
  @@index([name])
  @@index([createdById])
  @@index([deletedAt])
  @@map("foods")
}

model FoodNutrient {
  id                   String             @id @default(uuid()) @db.Uuid
  foodId               String             @map("food_id") @db.Uuid
  nutrientDefinitionId String             @map("nutrient_definition_id") @db.Uuid
  amount               Decimal            @db.Decimal(18, 6)
  food                 Food               @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrientDefinition   NutrientDefinition @relation(fields: [nutrientDefinitionId], references: [id], onDelete: Restrict)

  @@unique([foodId, nutrientDefinitionId])
  @@index([nutrientDefinitionId])
  @@map("food_nutrients")
}

model FoodServing {
  id                       String                    @id @default(uuid()) @db.Uuid
  foodId                   String                    @map("food_id") @db.Uuid
  name                     String                    @db.VarChar(100)
  quantity                 Decimal                   @db.Decimal(12, 4)
  unit                     String                    @db.VarChar(50)
  equivalentGrams          Decimal?                  @map("equivalent_grams") @db.Decimal(12, 4)
  equivalentMilliliters    Decimal?                  @map("equivalent_milliliters") @db.Decimal(12, 4)
  food                     Food                      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  mealItems                MealItem[]
  recipeIngredients        RecipeIngredient[]
  preparedBatchIngredients PreparedBatchIngredient[]

  @@index([foodId])
  @@map("food_servings")
}

model FoodAlias {
  id     String @id @default(uuid()) @db.Uuid
  foodId String @map("food_id") @db.Uuid
  alias  String @db.VarChar(150)
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, alias])
  @@index([alias])
  @@map("food_aliases")
}

model Meal {
  id             String       @id @default(uuid()) @db.Uuid
  householdId    String       @map("household_id") @db.Uuid
  adultProfileId String       @map("adult_profile_id") @db.Uuid
  mealType       MealType     @map("meal_type")
  consumedAt     DateTime     @map("consumed_at") @db.Timestamptz(6)
  status         MealStatus   @default(CONFIRMED)
  source         MealSource   @default(MANUAL)
  notes          String?      @db.Text
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  household      Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  adultProfile   AdultProfile @relation(fields: [adultProfileId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("MealCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items          MealItem[]
  plannedMeals   PlannedMeal[]
  digestiveSymptomMealLinks DigestiveSymptomMealLink[]
  digestiveSymptomFoodLinks DigestiveSymptomFoodLink[]

  @@index([householdId, consumedAt])
  @@index([adultProfileId, consumedAt])
  @@index([status, consumedAt])
  @@index([createdById])
  @@map("meals")
}

model MealItem {
  id                       String                     @id @default(uuid()) @db.Uuid
  mealId                   String                     @map("meal_id") @db.Uuid
