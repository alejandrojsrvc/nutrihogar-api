  source                 PlannedMealSource
  recipeId               String?            @map("recipe_id") @db.Uuid
  nameSnapshot           String?            @map("name_snapshot") @db.VarChar(150)
  nutritionSnapshot      Json?              @map("nutrition_snapshot")
  notes                  String?            @db.Text
  status                 PlannedMealStatus  @default(PLANNED)
  position               Int
  replacedMealId         String?            @map("replaced_meal_id") @db.Uuid
  preparedBatchId        String?            @map("prepared_batch_id") @db.Uuid
  mealId                 String?            @map("meal_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  weeklyPlan             WeeklyPlan         @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  recipe                 Recipe?            @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  preparedBatch          PreparedBatch?     @relation(fields: [preparedBatchId], references: [id], onDelete: SetNull)
  meal                   Meal?              @relation(fields: [mealId], references: [id], onDelete: SetNull)
  replacedMeal           PlannedMeal?       @relation("MealReplacement", fields: [replacedMealId], references: [id], onDelete: SetNull)
  replacementMeals       PlannedMeal[]       @relation("MealReplacement")
  participants           PlannedMealParticipant[]

  @@index([weeklyPlanId, date, type])
  @@index([weeklyPlanId, status])
  @@index([recipeId])
  @@index([replacedMealId])
  @@index([preparedBatchId])
  @@index([mealId])
  @@map("planned_meals")
}

model PlannedMealParticipant {
  id                       String       @id @default(uuid()) @db.Uuid
  plannedMealId            String       @map("planned_meal_id") @db.Uuid
  adultProfileId           String       @map("adult_profile_id") @db.Uuid
  suggestedQuantity        Decimal?     @map("suggested_quantity") @db.Decimal(30, 12)
  suggestedUnit            String?      @map("suggested_unit") @db.VarChar(50)
  confirmedQuantity        Decimal?     @map("confirmed_quantity") @db.Decimal(30, 12)
  confirmedUnit            String?      @map("confirmed_unit") @db.VarChar(50)
  confirmedById            String?      @map("confirmed_by_id") @db.Uuid
  confirmedAt              DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  confirmationSnapshot     Json?        @map("confirmation_snapshot")
  nutritionTargetSnapshot  Json?        @map("nutrition_target_snapshot")
  notes                    String?      @db.Text
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  plannedMeal              PlannedMeal  @relation(fields: [plannedMealId], references: [id], onDelete: Cascade)
  adultProfile             AdultProfile @relation(fields: [adultProfileId], references: [id], onDelete: Cascade)
  confirmedBy              User?        @relation("PlannedMealParticipantConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([plannedMealId, adultProfileId])
  @@index([plannedMealId])
  @@index([adultProfileId])
  @@index([confirmedById])
  @@map("planned_meal_participants")
}

model InventoryMovement {
  id              String                @id @default(uuid()) @db.Uuid
  itemId          String                @map("item_id") @db.Uuid
  type            InventoryMovementType
  quantity        Decimal               @db.Decimal(30, 12)
  unit            InventoryUnit
  occurredAt      DateTime              @map("occurred_at") @db.Timestamptz(6)
  sourceType      String?               @map("source_type") @db.VarChar(50)
  sourceId        String?               @map("source_id") @db.VarChar(255)
  reason          String?               @db.Text
  actorId         String?               @map("actor_id") @db.Uuid
  deviceId        String?               @map("device_id") @db.VarChar(255)
  syncOperationId String?               @unique @map("sync_operation_id") @db.VarChar(255)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  item            InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor           User?                 @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([itemId, occurredAt])
  @@index([itemId, type, occurredAt])
  @@index([actorId])
  @@map("inventory_movements")
}

enum InventorySyncOperationStatus {
  APPLIED
  CONFLICT
}

model InventorySyncOperation {
  id                 String                     @id @default(uuid()) @db.Uuid
  operationId        String                     @unique @map("operation_id") @db.VarChar(255)
  householdId        String                     @map("household_id") @db.Uuid
  inventoryItemId    String?                    @map("inventory_item_id") @db.Uuid
  actorId            String                     @map("actor_id") @db.Uuid
  deviceId           String                     @map("device_id") @db.VarChar(255)
  status             InventorySyncOperationStatus
  reason             String?                    @db.Text
  resultingVersion   Int?                       @map("resulting_version")
  snapshot           Json?
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  household          Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem?             @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  actor              User                       @relation("InventorySyncOperationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([householdId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@map("inventory_sync_operations")
}
